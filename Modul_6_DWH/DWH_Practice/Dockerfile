# 1. Берем базовый образ с Python
FROM python:3.11-slim

# 2. Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# 3. Копируем наш скрипт из папки на компьютере в папку внутри контейнера
COPY app.py .

# 4. Команда, которая выполнится при запуске контейнера
CMD ["python", "-u", "app.py"]